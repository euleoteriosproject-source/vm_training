{
  "name": "vm-training",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types scripts/media/verify-media.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:user:local": "node --experimental-strip-types scripts/ensure-local-test-user.ts",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset",
    "media:discover": "node --experimental-strip-types scripts/media/discover-wikimedia.ts",
    "media:rediscover": "node --experimental-strip-types scripts/media/discover-wikimedia.ts --dry-run --missing-only --expanded",
    "media:integration": "node --experimental-strip-types scripts/media/discover-wikimedia.ts --dry-run --exercise leg-extension --limit 2",
    "media:rescore": "node --experimental-strip-types scripts/media/rescore-candidates.ts",
    "media:discover:unmapped": "node --experimental-strip-types scripts/media/discover-unmapped.ts",
    "media:import": "node --experimental-strip-types scripts/media/import-wikimedia.ts",
    "media:process": "node --experimental-strip-types scripts/media/process-video.ts",
    "media:local": "node --experimental-strip-types scripts/media/import-local-pack.ts",
    "media:report": "node --experimental-strip-types scripts/media/media-report.ts",
    "media:validate": "node --experimental-strip-types scripts/media/verify-media.ts",
    "media:licenses": "node --experimental-strip-types scripts/media/generate-licenses.ts",
    "media:sync-candidates": "node --experimental-strip-types scripts/media/sync-candidates.ts",
    "media:validate:prepare": "node --experimental-strip-types scripts/media/prepare-validation.ts",
    "media:validate:finalize": "node --experimental-strip-types scripts/media/finalize-validation.ts",
    "media:validate:apply": "node --experimental-strip-types scripts/media/apply-validation.ts",
    "media:ffmpeg-check": "node --experimental-strip-types scripts/media/ffmpeg-check.ts",
    "media:process-pending": "node --experimental-strip-types scripts/media/process-pending.ts",
    "media:process:v16": "node --experimental-strip-types scripts/media/process-primary-v16.ts --dry-run",
    "media:finalize:v17": "node --experimental-strip-types scripts/media/finalize-v17.ts --dry-run",
    "media:finalize:v17:apply": "node --experimental-strip-types scripts/media/finalize-v17.ts --apply",
    "media:manifest-check": "node --experimental-strip-types scripts/media/verify-primary-manifest.ts",
    "media:reconcile": "node --experimental-strip-types scripts/media/reconcile.ts",
    "media:production-report": "node --experimental-strip-types scripts/media/production-report.ts",
    "media:storage-check": "node --experimental-strip-types scripts/media/storage-check.ts",
    "release:check": "node --experimental-strip-types scripts/release-check.ts",
    "release:report": "node --experimental-strip-types scripts/release-report.ts",
    "smoke:production": "node --experimental-strip-types scripts/smoke-production.ts",
    "security:grants:local": "node --experimental-strip-types scripts/security/capture-grant-matrix.ts",
    "security:grants:production": "node --experimental-strip-types scripts/security/capture-grant-matrix.ts --production",
    "security:grants:diff": "node --experimental-strip-types scripts/security/compare-grant-matrices.ts",
    "security:grants:test": "supabase test db --local supabase/tests/grant_contract.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.544.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "supabase": "^2.47.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
